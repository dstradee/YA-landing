# ==============================================================================
# YA DELIVERY - VARIABLES DE ENTORNO (FASE 3C.3: PAYPAL SANDBOX Y LIVE)
# ==============================================================================

# Supabase Credentials
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
# Servidor Supabase (usa una de las dos)
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dominio y URL Base de la Aplicación (utilizado para retornos de PayPal y Webhooks)
APP_URL=https://ya-delivery.es

# ------------------------------------------------------------------------------
# PAYPAL CONFIGURACIÓN GLOBAL (SANDBOX vs LIVE)
# ------------------------------------------------------------------------------
# Selecciona el entorno activo: 'sandbox' (desarrollo/pruebas) o 'live' (producción)
# Valores admitidos: 'sandbox', 'live', 'production'
PAYPAL_MODE=sandbox
# Alternativa soportada: PAYPAL_ENVIRONMENT=sandbox

# Credenciales de Servidor (NUNCA exponer en cliente ni usar prefijo VITE_)
# En Vercel puedes definir estos valores en Environment Variables (Production vs Preview/Development):
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Alternativa: Credenciales explícitas separadas por entorno (opcional)
# PAYPAL_SANDBOX_CLIENT_ID=
# PAYPAL_SANDBOX_CLIENT_SECRET=
# PAYPAL_SANDBOX_WEBHOOK_ID=
# PAYPAL_LIVE_CLIENT_ID=
# PAYPAL_LIVE_CLIENT_SECRET=
# PAYPAL_LIVE_WEBHOOK_ID=

# Identificador público de cliente (Opcional en frontend, el backend ya lo expone en /api/paypal/config)
VITE_PAYPAL_CLIENT_ID=